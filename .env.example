# Copy to .env and fill in your local paths. DO NOT commit .env.
# Firebase Admin service-account key used by local tooling (tmr.py, fonts.py).
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccountKey.json

# Operator gate PIN (index.html, js/dashboard.js).
OPERATOR_PIN=0000

# Firebase web config — primary project (most pages).
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXX

# Firebase web config — caster project (castersPredictions.html, caster.js, caster1.js, caster2.js).
CASTER_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CASTER_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
CASTER_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
CASTER_FIREBASE_PROJECT_ID=your-project
CASTER_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
CASTER_FIREBASE_MESSAGING_SENDER_ID=000000000000
CASTER_FIREBASE_APP_ID=1:000000000000:web:XXXXXXXXXXXXXXXX

# Google Apps Script export endpoint (js/buttons.js, js/controller.js).
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXX/exec
